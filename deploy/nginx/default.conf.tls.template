server {
    listen 80;
    server_name ${SERVER_NAME};

    # This block is nearly all redirects, and would otherwise have been the one
    # place still logging full addresses -- every visitor passes through it
    # before reaching HTTPS.
    access_log /var/log/nginx/access.log anonymised;

    # ACME challenge location
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    # Redirect everything else to HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name ${SERVER_NAME};

    # Big enough for what the application already says it will accept.
    #
    # nginx's default is 1 MB and the application's limits are 2 MB for one
    # attached file and 8 MB for a table's files together -- so the larger
    # half of the application's own rule was unreachable, and a 1.4 MB
    # generator data file was refused with a bare 413 from nginx that never
    # reached Django and so said nothing about which limit it had met.
    #
    # 10 MB leaves room for the 8 MB case plus the rest of a request.
    client_max_body_size 10m;

    # Replaces the http-block default, which logs the full IP. A second
    # access_log beside it would log twice rather than replace it, so it has to
    # live here. See 00-logging.conf.
    access_log /var/log/nginx/access.log anonymised;

    # Resolve Docker DNS for service names at runtime to avoid stale IPs
    resolver 127.0.0.11 ipv6=off valid=10s;
    set $upstream http://web:8000;

    ssl_certificate /etc/letsencrypt/live/${SERVER_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SERVER_NAME}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    # ACME challenge must still be reachable
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    # Static assets
    location /static/ {
        alias /staticfiles/;
        access_log off;
        expires 7d;
    }

    # App proxy
    location / {
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass $upstream;
        proxy_read_timeout 300;
    }
}
