SECRET_KEY=password1_to_be_changed
DEBUG=TRUE
ALLOWED_HOSTS=.localhost,127.0.0.1,.numberdb.org,172.104.29.29

DATABASE_URL=postgres://u_numberdb:password2_to_be_changed@localhost:5432/numberdb
# Use Postgres for local development as well; SQLite is discouraged.


SOCIALACCOUNT_GITHUB_ID=
SOCIALACCOUNT_GITHUB_SECRET=

ACCOUNT_DEFAULT_HTTP_PROTOCOL=http

# Mail. With no key, messages are printed to the console, which is what you
# want in development. Setting EMAIL_MG_API_KEY switches delivery on by itself;
# numberdb.org sends through Mailgun.
#
# Do NOT set EMAIL_BACKEND explicitly alongside a key: an explicit console
# backend silently wins over the key, which is how production ran with account
# email switched on and nothing being delivered.
EMAIL_MG_API_KEY=
EMAIL_MG_SENDER_DOMAIN=
#Only for the EU region: https://api.eu.mailgun.net/v3
EMAIL_MG_API_BASE_URL=
DEFAULT_FROM_EMAIL=NumberDB <noreply@mail.numberdb.org>
#EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# 'optional' until mail is known to be delivering. Setting this to 'mandatory'
# while mail is broken locks every new user out of the account they just made.
ACCOUNT_EMAIL_VERIFICATION=optional

# Deployment convenience (used by Makefile deploy_* wrappers)
# Set these to avoid passing REMOTE/DOMAIN/EMAIL/RPATH on the command line.
DEPLOY_REMOTE=
DEPLOY_RPATH=/opt/numberdb-website
DEPLOY_DOMAIN=example.org
DEPLOY_EMAIL=admin@example.org
