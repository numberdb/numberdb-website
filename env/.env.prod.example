# Production environment for numberdb.org.
#
# Copy this to the deployment directory and fill in the four values marked
# CHANGE ME:
#
#     cp env/.env.prod.example /opt/numberdb-website/.env
#     chmod 600 /opt/numberdb-website/.env
#
# Every variable here is read either by Django (see `numberdb/settings/`) or by
# docker compose. Nothing in it is decorative, and anything absent from it is
# read by nothing.
#
#
# THE FILE ON THE SERVER IS CALLED .env, NOT .env.prod
#
# `docker-compose.yml` says `env_file: - .env`, and nothing anywhere reads
# `.env.prod`. A `.env.prod` sitting beside it is therefore not a second
# configuration but a decoy: it can rot indefinitely without anything breaking,
# and reading it will tell you things about the deployment that are not true.
#
# On this deployment in August 2026 the stale `.env.prod` claimed
# SERVER_NAME=45.33.90.86 and LETSENCRYPT_EMAIL=admin@example.invalid, while
# the live `.env` had both correct. Keep exactly one file.


### Django core ###############################################################

# CHANGE ME. Any long random string. Rotating it logs everyone out.
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

DEBUG=False

# Every hostname the site answers to. The leading dot covers subdomains. Keep
# the bare IP only if you reach the server that way while DNS is in flux.
ALLOWED_HOSTS=numberdb.org,.numberdb.org,127.0.0.1,.localhost

# Write the password out in full. python-decouple, which reads this file for
# Django, does NOT expand ${VAR}: it would hand Django the literal text
# "${POSTGRES_KEY}" as the password. (docker compose does expand it, which is
# what makes the mistake survive long enough to be confusing.)
#
# In the current deployment this line is overridden anyway: docker-compose.yml
# sets DATABASE_URL in `environment:`, where compose does the expansion. It
# still matters for `manage.py` run outside a container.
DATABASE_URL=postgres://u_numberdb:PASSWORD_FROM_POSTGRES_KEY_BELOW@db:5432/numberdb


### Site identity and TLS #####################################################

# The domain the certificate is issued for and that nginx serves. The nginx
# entrypoint chooses its HTTPS configuration by looking for
# /etc/letsencrypt/live/${SERVER_NAME}, so a wrong value here quietly drops the
# site to plain HTTP the next time the container is recreated.
SERVER_NAME=numberdb.org

# Where Let's Encrypt sends expiry warnings. With a placeholder address, the
# first warning you receive is the outage.
LETSENCRYPT_EMAIL=you@example.org


### Accounts and login ########################################################

# https in production. While this said http, every URL allauth built without a
# request behind it (password resets, confirmation links) pointed at http://.
ACCOUNT_DEFAULT_HTTP_PROTOCOL=https

# CHANGE ME. From https://github.com/settings/developers:
#   Homepage URL:  https://numberdb.org
#   Callback URL:  https://numberdb.org/accounts/github/login/callback/
# Left empty, the GitHub button is still shown and the redirect fails with
# nothing logged anywhere. `manage.py check` reports this as numberdb.W001.
SOCIALACCOUNT_GITHUB_ID=
SOCIALACCOUNT_GITHUB_SECRET=

# 'optional' or 'mandatory'. Keep it optional until a real message has been
# seen to arrive: mandatory verification with undelivered mail locks every new
# user out of the account they have just created (numberdb.W003).
ACCOUNT_EMAIL_VERIFICATION=optional


### Mail ######################################################################

# numberdb.org sends through Mailgun, where the sending domain is verified.
# Setting the key is the whole configuration; the backend follows from it.
#
# CHANGE ME. Mailgun dashboard, under Sending, Domain settings, API keys.
EMAIL_MG_API_KEY=

# The domain verified in Mailgun that mail is sent through. Both numberdb.org
# and mg.numberdb.org are verified; the apex is used, so that messages come
# from the address people recognise. Confirm a domain is really active with:
#     curl -s --user "api:$EMAIL_MG_API_KEY" \
#          https://api.mailgun.net/v3/domains | grep -o '"state":"[a-z]*"'
# Adding DNS records does not verify a domain by itself: Mailgun only re-checks
# when asked, and refuses mail for any domain not in the active state.
EMAIL_MG_SENDER_DOMAIN=numberdb.org

# Not a secret: just which Mailgun region the domain lives in. Leave empty for
# the US (the default); set https://api.eu.mailgun.net/v3 for the EU. DNS looks
# identical either way, so this has to be read off the Mailgun dashboard, and
# the wrong choice fails authentication with an error that never mentions
# regions.
EMAIL_MG_API_BASE_URL=

# The domain here must match EMAIL_MG_SENDER_DOMAIN, or Mailgun refuses the
# message as coming from a domain it does not host.
DEFAULT_FROM_EMAIL=NumberDB <noreply@numberdb.org>

# Deliberately left unset. An explicit backend overrides the key above, and
# that is precisely how production ran for months with account email switched
# on and not one message delivered (numberdb.W002).
#EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend


### Postgres ##################################################################

# CHANGE ME. Must match the password inside DATABASE_URL above.
POSTGRES_KEY=

# Tuned for a 1 GB machine; raise these together with the VM, not one by one.
PG_SHARED_BUFFERS=128MB
PG_WORK_MEM=16MB
PG_MAINTENANCE_WORK_MEM=128MB
PG_EFFECTIVE_CACHE_SIZE=512MB
PG_WAL_COMPRESSION=on
# 'off' risks losing the last fraction of a second of commits in a hard crash.
# For a database that can be rebuilt from a git repository, that is a fair
# trade for the write throughput.
PG_SYNCHRONOUS_COMMIT=off
PG_MAX_WAL_SIZE=512MB
PG_CHECKPOINT_TIMEOUT=10min


### Runtime ###################################################################

# One worker fits a 1 GB machine, since each one loads SageMath.
GUNICORN_WORKERS=1

# Apply migrations on container start, so a deploy carrying a migration cannot
# be left half done.
AUTO_MIGRATE=1

# Extra compose files layered over docker-compose.yml, colon separated. The
# current deployment adds a host-level override kept outside this repository.
#COMPOSE_FILE=docker-compose.yml:/opt/site-edge/numberdb.override.yml


### Sage and the Makefile #####################################################

SAGE=export PYTHONPATH=./:${PYTHONPATH}; sage
PYTHON=$(SAGE) -python
PIP=$(SAGE) -pip
#Use these instead if sage is importable from the system python:
#PYTHON=python
#PIP=pip
MANAGE=$(PYTHON) manage.py


### Deployment convenience ####################################################

# Used by the `make deploy_*` wrappers, so the arguments need not be retyped.
DEPLOY_REMOTE=
DEPLOY_RPATH=/opt/numberdb-website
DEPLOY_DOMAIN=numberdb.org
DEPLOY_EMAIL=you@example.org
