SECRET_KEY=password1_to_be_changed
POSTGRES_KEY=password2_to_be_changed
DEBUG=FALSE
ALLOWED_HOSTS=.numberdb.org

DATABASE_URL=postgres://u_numberdb:${POSTGRES_KEY}@localhost:5432/numberdb

ACCOUNT_DEFAULT_HTTP_PROTOCOL=https

SOCIALACCOUNT_GITHUB_ID=
SOCIALACCOUNT_GITHUB_SECRET=

#Setting the key is the whole configuration: the backend follows from it.
#Do not set EMAIL_BACKEND as well, or an explicit value will override the key.
EMAIL_MG_API_KEY=
EMAIL_MG_SENDER_DOMAIN=mail.numberdb.org
#Only for the EU region: https://api.eu.mailgun.net/v3
EMAIL_MG_API_BASE_URL=
DEFAULT_FROM_EMAIL=NumberDB <noreply@mail.numberdb.org>
ACCOUNT_EMAIL_VERIFICATION=optional

SAGE=export PYTHONPATH=./:${PYTHONPATH}; sage

PYTHON=$(SAGE) -python
PIP=$(SAGE) -pip
#Use the following paths for python and pip if sage is importable within the system's python:
#PYTHON=python
#PIP=pip

MANAGE=$(PYTHON) manage.py

# Deployment convenience (used by Makefile deploy_* wrappers)
# Set these to avoid passing REMOTE/DOMAIN/EMAIL/RPATH on the command line.
DEPLOY_REMOTE=
DEPLOY_RPATH=/opt/numberdb-website
DEPLOY_DOMAIN=example.org
DEPLOY_EMAIL=admin@example.org
